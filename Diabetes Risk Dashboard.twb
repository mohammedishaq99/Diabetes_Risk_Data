            </column>
            <column caption='Risk Group Label' datatype='string' name='[Calculation_2228322632794114]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [hypertension] = 0 AND [heart_disease] = 0 THEN &quot;Neither condition&quot;&#10;ELSEIF [hypertension] = 1 AND [heart_disease] = 0 THEN &quot;Hypertension only&quot;&#10;ELSEIF [hypertension] = 0 AND [heart_disease] = 1 THEN &quot;Heart disease only&quot;&#10;ELSE &quot;Both conditions&quot;&#10;END' />
            </column>
            <column caption='BMI Category' datatype='string' name='[Calculation_2228322636554243]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [bmi] &lt; 18.5 THEN &quot;Underweight&quot;&#10;ELSEIF [bmi] &lt; 25 THEN &quot;Normal&quot;&#10;ELSEIF [bmi] &lt; 30 THEN &quot;Overweight&quot;&#10;ELSEIF [bmi] &lt; 35 THEN &quot;Obese I&quot;&#10;ELSEIF [bmi] &lt; 40 THEN &quot;Obese II&quot;&#10;ELSE &quot;Obese III+&quot;&#10;END' />
            </column>
            <column caption='Overall Diabetes Prevelance' datatype='real' default-format='p0.00%' name='[Calculation_2228322637901829]' role='measure' type='quantitative'>
