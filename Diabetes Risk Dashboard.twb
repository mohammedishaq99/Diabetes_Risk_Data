        <calculation class='bin' decimals='0' formula='[age]' peg='0' size='5' />
      </column>
      <column aggregation='None' caption='Blood Glucose Level (bin)' datatype='integer' name='[Blood Glucose Level (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='1' formula='[blood_glucose_level]' peg='0' size='20' />
      </column>
      <column caption='Diabetes Rate' datatype='real' default-format='p0.00%' name='[Calculation_2228322411270145]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([diabetes])/COUNT([diabetes])' />
      </column>
      <column caption='Risk Group Label' datatype='string' name='[Calculation_2228322632794114]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [hypertension] = 0 AND [heart_disease] = 0 THEN &quot;Neither condition&quot;&#10;ELSEIF [hypertension] = 1 AND [heart_disease] = 0 THEN &quot;Hypertension only&quot;&#10;ELSEIF [hypertension] = 0 AND [heart_disease] = 1 THEN &quot;Heart disease only&quot;&#10;ELSE &quot;Both conditions&quot;&#10;END' />
      </column>
      <column caption='BMI Category' datatype='string' name='[Calculation_2228322636554243]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [bmi] &lt; 18.5 THEN &quot;Underweight&quot;&#10;ELSEIF [bmi] &lt; 25 THEN &quot;Normal&quot;&#10;ELSEIF [bmi] &lt; 30 THEN &quot;Overweight&quot;&#10;ELSEIF [bmi] &lt; 35 THEN &quot;Obese I&quot;&#10;ELSEIF [bmi] &lt; 40 THEN &quot;Obese II&quot;&#10;ELSE &quot;Obese III+&quot;&#10;END' />
      </column>
      <column caption='Total Patient' datatype='integer' default-format='p0.00%' name='[Calculation_2228322637721604]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([diabetes])' />
      </column>
      <column caption='Overall Diabetes Prevelance' datatype='real' default-format='p0.00%' name='[Calculation_2228322637901829]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([diabetes])/COUNT([diabetes])' />
      </column>
      <column caption='Average Bmi' datatype='real' default-format='p0.00%' name='[Calculation_2228322638180358]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([bmi])' />
      </column>
      <column caption='Average HbA1c' datatype='real' name='[Calculation_2228322638327815]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([hba1c_level])' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_2290788774395904]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [age] &lt;= 18 THEN &quot;0–18&quot;&#10;ELSEIF [age] &lt;= 35 THEN &quot;19–35&quot;&#10;ELSEIF [age] &lt;= 50 THEN &quot;36–50&quot;&#10;ELSEIF [age] &lt;= 65 THEN &quot;51–65&quot;&#10;ELSE &quot;65+&quot;&#10;END' />
      </column>
      <column aggregation='None' caption='Hba1C Level (bin)' datatype='integer' name='[Hba1C Level (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='-1' formula='[hba1c_level]' peg='0' size='0.5' />
      </column>
