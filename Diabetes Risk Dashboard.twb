              <calculation class='tableau' formula='IF [hypertension] = 0 AND [heart_disease] = 0 THEN &quot;Neither condition&quot;&#10;ELSEIF [hypertension] = 1 AND [heart_disease] = 0 THEN &quot;Hypertension only&quot;&#10;ELSEIF [hypertension] = 0 AND [heart_disease] = 1 THEN &quot;Heart disease only&quot;&#10;ELSE &quot;Both conditions&quot;&#10;END' />
